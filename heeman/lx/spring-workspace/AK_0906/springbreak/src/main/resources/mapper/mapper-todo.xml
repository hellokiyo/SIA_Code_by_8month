<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="mapper-todo">

  <!-- 공통 컬럼 -->
  <sql id="columns">
    id, content, completed, created_date
  </sql>

  <!-- VO 매핑 -->
  <resultMap id="ToDoMap" type="lx.edu.springbreak.vo.ToDoVO">
    <id     property="id"           column="id" />
    <result property="content"      column="content" />
    <result property="completed"    column="completed" />
    <result property="created_date" column="created_date" />
  </resultMap>

  <!-- 리스트 조회 -->
  <select id="getDBList" resultMap="ToDoMap">
    SELECT <include refid="columns" />
    FROM todo
    ORDER BY id DESC
  </select>

  <!-- 완료여부로 필터링 -->
  <select id="getTodoCompleteList" parameterType="boolean" resultMap="ToDoMap">
    SELECT <include refid="columns" />
    FROM todo
    WHERE completed = #{completed}
    ORDER BY id DESC
  </select>

  <!-- 단건 조회 -->
  <select id="getDB" parameterType="int" resultMap="ToDoMap">
    SELECT <include refid="columns" />
    FROM todo
    WHERE id = #{id}
  </select>

  <!-- 삽입 -->
  <insert id="insertDB" parameterType="lx.edu.springbreak.vo.ToDoVO" useGeneratedKeys="true" keyProperty="id">
    INSERT INTO todo (content, completed)
    VALUES (#{content}, #{completed})
  </insert>

  <!-- 수정 -->
  <update id="updateDB" parameterType="lx.edu.springbreak.vo.ToDoVO">
    UPDATE todo
    SET
      content = #{content},
      completed = #{completed}
    WHERE id = #{id}
  </update>

  <!-- 삭제 -->
  <delete id="deleteDB" parameterType="int">
    DELETE FROM todo
    WHERE id = #{id}
  </delete>

</mapper>
